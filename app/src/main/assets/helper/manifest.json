{
  "manifest_version": 2,
  "name": "Grove helper",
  "version": "1.1",
  "description": "Picture-in-picture, mini player, background play and reader view for Grove Browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "helper@grove.browser"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "Readability.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}