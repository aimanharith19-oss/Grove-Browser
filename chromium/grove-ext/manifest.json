{
  "manifest_version": 3,
  "name": "Grove",
  "version": "1.0.0",
  "description": "Grove Browser's home page, reader view and offline pages, mini player and picture-in-picture for every video, background play, and no YouTube \"still watching\" interruptions.",
  "icons": { "48": "icon48.png", "128": "icon128.png" },
  "minimum_chrome_version": "111",
  "permissions": ["bookmarks", "topSites", "tabs", "storage", "unlimitedStorage", "scripting", "downloads", "history", "favicon", "search"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bg.js" },
  "chrome_url_overrides": { "newtab": "home.html" },
  "action": { "default_popup": "popup.html", "default_title": "Grove" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["page.js"], "run_at": "document_start", "all_frames": false },
    { "matches": ["<all_urls>"], "js": ["main.js"], "run_at": "document_start", "all_frames": false, "world": "MAIN" }
  ],
  "web_accessible_resources": [{ "resources": ["reader.html"], "matches": ["<all_urls>"] }]
}
